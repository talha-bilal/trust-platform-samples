# Copy to .env and edit for each customer / cloud deployment
# Used by: setup/fresh-deploy.ps1, setup/render-tenant-config.ps1

# --- Branding (shown on login + app launcher; also set in Keycloak Admin) ---
COMPANY_DISPLAY_NAME=SecureLink IAM Demo
REALM_NAME=company

# --- Public URLs (use your cloud VM IP or DNS) ---
# Example cloud: http://203.0.113.10  or  https://iam-demo.customer.sa
PUBLIC_HOST=http://localhost
KEYCLOAK_PORT=8080
APP_LAUNCHER_PORT=3000
HR_PORTAL_PORT=3001
FINANCE_PORTAL_PORT=3002

# --- Keycloak admin (change before cloud deploy) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Demo directory (stands in for AD until real LDAPS is configured) ---
LDAP_ORGANISATION=Demo Company
LDAP_DOMAIN=company.local
LDAP_ADMIN_PASSWORD=admin

# --- Database (change passwords in production) ---
POSTGRES_PASSWORD=keycloak
